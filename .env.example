# =====================================================
# Scrumlens Production Environment Configuration
# Uses FerretDB (MongoDB-compatible) + PostgreSQL
# Copy this file to .env and fill in the values
# =====================================================

# Server Port (internal only, behind reverse proxy)
API_PORT=3000

# Secret key for JWT tokens (auto-generated on first run)
# You can leave this as-is; it gets auto-generated by the setup script

# FerretDB connection string (MongoDB wire protocol)
# Default: Local FerretDB instance on port 27017
# For external FerretDB: mongodb://host:27017/scrumlens
MONGO_URL=mongodb://localhost:27017/scrumlens

# Client URL (used for redirects)
# If behind reverse proxy with domain: https://scrumlens.your-domain.com
# If using IP directly: http://<container-ip>:3000
CLIENT_URL=http://localhost:3001

# Node environment
NODE_ENV=production

# =====================================================
# Email Configuration (OPTIONAL - for invite/verify emails)
# Leave empty if not needed (most features don't require email)
# =====================================================
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# =====================================================
# That's it! Only MONGO_URL and CLIENT_URL really need changes.
# The setup script auto-generates SECRET_KEY for you.
# =====================================================